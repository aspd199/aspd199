# =============================================================================
# Standard .gitignore - general purpose template
# Scope: OS metadata, editor/IDE state, dependencies, build artifacts,
#        logs/temp files, coverage reports and local secrets.
# Trim language-specific sections as needed; do not ignore tracked assets.
# =============================================================================

# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/
*.swp
*.swo
*~.nib

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
build/
dist/
out/
target/
bin/
obj/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.class
.next/
.nuxt/
.svelte-kit/
.parcel-cache/
.cache/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Logs, temporary files, coverage
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/
coverage/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# -----------------------------------------------------------------------------
# Local configuration and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Archives / large binaries
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.dmg
*.iso
